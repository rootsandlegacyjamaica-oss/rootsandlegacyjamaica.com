# Copy to .env for local testing only. In production set these in Netlify → Environment variables.
# Never commit real API keys.

RESEND_API_KEY=re_your_key_here
RESEND_FROM="Roots&LegacyJamaica" <bookings@my.rootsandlegacyjamaica.com>
HOST_NOTIFY_EMAIL=my.rootsandlegacyjamaica@gmail.com

# Same secret string in Cal.com → Webhook settings (optional but recommended)
CAL_WEBHOOK_SECRET=

# Not used by the booking email function (webhooks do not need this). Optional for future Cal.com REST API scripts.
# CAL_API_KEY=
