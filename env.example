# Copy to .env for local testing only. In production set these in Netlify → Environment variables.
# Never commit real API keys.

RESEND_API_KEY=re_your_key_here
RESEND_FROM="Roots&LegacyJamaica" <bookings@my.rootsandlegacyjamaica.com>
HOST_NOTIFY_EMAIL=my.rootsandlegacyjamaica@gmail.com

# Same secret string in Cal.com → Webhook settings (optional but recommended)
CAL_WEBHOOK_SECRET=

# Cal.com API (CLI scripts: npm run cal:meet). Not used by Netlify functions.
# CALCOM_API_KEY=cal_live_...
# EVENT_TYPE_ID=12345   # only for npm run cal:meet-event

# Contact form (Resend) — inbox for inquiries; Reply-To is the visitor’s email
# CONTACT_NOTIFY_EMAIL=rootsandlegacyjamaica@gmail.com
# Set to false to skip the auto-reply to the visitor
# CONTACT_SEND_CONFIRMATION=true
